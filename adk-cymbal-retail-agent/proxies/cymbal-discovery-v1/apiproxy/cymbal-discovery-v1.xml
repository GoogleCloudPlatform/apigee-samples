<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="cymbal-discovery-v1">
  <BasePaths>/mcp</BasePaths>
  <BasePaths>/.well-known/oauth-protected-resource/mcp</BasePaths>
    <Description>Native Apigee MCP Discovery Proxy</Description>
    <DisplayName>cymbal-discovery-v1</DisplayName>
    <Policies/>
    <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
    <ProxyEndpoint>oauth-prm-endpoint</ProxyEndpoint>
    </ProxyEndpoints>
    <Resources>
        <Resource>oas://customers.yaml</Resource>
        <Resource>oas://orders.yaml</Resource>
        <Resource>oas://returns.yaml</Resource>
        <Resource>oas://shipping.yaml</Resource>
    </Resources>
    <TargetEndpoints>
        <TargetEndpoint>default</TargetEndpoint>
        <TargetEndpoint>oauth-prm-endpoint</TargetEndpoint>
    </TargetEndpoints>
</APIProxy>
