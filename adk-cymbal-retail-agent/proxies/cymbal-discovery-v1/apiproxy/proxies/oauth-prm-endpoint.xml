<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="oauth-prm-endpoint">
  <HTTPProxyConnection>
    <BasePath>/.well-known/oauth-protected-resource/mcp</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <RouteRule name="default">
    <TargetEndpoint>oauth-prm-endpoint</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
