<TargetEndpoint name="gemma">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-DisablePathSuffixCopy</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>JS-ExtractTokenCount</Name>
        <Condition>response.content != null</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>llm_token_quota_enforce != "false"</Condition>
      </Step>
      <Step>
        <Name>DC-CollectTokenCounts</Name>
      </Step>
      <Step>
        <Name>AM-ExtractResponsePromptOpenAI</Name>
        <Condition>response.content != null</Condition>
      </Step>
      <Step>
        <Name>FC-SanitizeModelResponse</Name>
        <Condition>( response.content != null ) and ( response_prompt_value != null ) and ( response_prompt_value != "" ) and ( llm_sanitize_model_response != "false" )</Condition>
      </Step>
      <Step>
        <Name>SCP-Semantic-Cache-Populate</Name>
        <Condition>(response.content != null) and (cache_enabled != "false")</Condition>
      </Step>
    </Response>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <!-- 
      Google Cloud OIDC ID Token Authentication:
      Secures communication between Apigee and Cloud Run in enterprise GCP orgs where
      Domain-Restricted Sharing blocks 'allUsers' unauthenticated access.
      Uses the deployed proxy's service account (apigee-vertex-ai-caller@PROJECT_ID.iam.gserviceaccount.com)
      which is granted 'roles/run.invoker' on the Cloud Run service.
    -->
    <Authentication>
      <GoogleIDToken>
        <Audience>https://gemma-cpu-router-78901377646.us-central1.run.app</Audience>
      </GoogleIDToken>
    </Authentication>
    <URL>https://gemma-cpu-router-78901377646.us-central1.run.app/v1/chat/completions</URL>
  </HTTPTargetConnection>
  <DefaultFaultRule name="default-fault">
    <Step>
      <Name>JS-SetFailover</Name>
    </Step>
    <Step>
      <Name>SC-VertexFailover</Name>
    </Step>
    <Step>
      <Name>JS-ProcessFailoverResponse</Name>
    </Step>
    <Step>
      <Name>JS-ParseVertexResponse</Name>
    </Step>
  </DefaultFaultRule>
</TargetEndpoint>
